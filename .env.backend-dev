# Runtime config overrides for running the SPA against the Dataverse backend dev env
# (docker-compose-dev.yml + docker-compose-dev.spa.yml in IQSS/dataverse).
# Used by `npm run start:backend-dev` and `npm run build:backend-dev`.
DATAVERSE_BACKEND_URL=http://localhost:8080
OIDC_AUTHORIZATION_ENDPOINT=http://localhost:8090/realms/test/protocol/openid-connect/auth
OIDC_TOKEN_ENDPOINT=http://localhost:8090/realms/test/protocol/openid-connect/token
OIDC_LOGOUT_ENDPOINT=http://localhost:8090/realms/test/protocol/openid-connect/logout
